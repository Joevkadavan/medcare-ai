# MedCare AI - backend environment

# Comma-separated list of allowed frontend origins.
# Dev: localhost + Codespaces forwarded URL. Prod: your deployed domain.
FRONTEND_URL=http://localhost:3000

# LLM provider key. Leave EMPTY to run in MOCK AI MODE.
# The app works fully without a key — responses become deterministic rule-based output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to force mock mode even when a key is present.
MOCK_AI_ONLY=false

# Retrieval / RAG
RAG_ENABLED=true
RAG_TOP_K=4
